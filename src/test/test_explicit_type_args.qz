// Explicit generic type arguments: f<T, ...>(...).

import "@std/mem/arena.qz"

function id<T>(x: T): T => x
function first<A, B>(a: A, b: B): A => a

function main() {
    if(id<int64>(5) != 5) return 1
    if(id<string>("hi") != "hi") return 1
    if(first<int64, bool>(7, true) != 7) return 1

    // The motivating case: a type that cannot be inferred from the arguments.
    var arena = new Arena(256)
    defer arena.release()
    var xs = arenaAlloc<int64>(arena, 3)
    xs[0] = 1
    xs[1] = 2
    xs[2] = 3
    if(xs[0] + xs[1] + xs[2] != 6) return 1

    return 0
}
