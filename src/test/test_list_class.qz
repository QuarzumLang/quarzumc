struct Node {
    var value: int64

    function Node(v: int64){
        this.value = v
    }

    function getValue() : int64 {
        return this.value
    }
}

struct ClassList<T> {
    var data: ptr<T>
    var capacity: uint64
    var size: uint64

    function ClassList(){
        this.capacity = 16
        this.size = 0
        this.data = new T[this.capacity]
    }

    function add(element: T){
        if(this.size >= this.capacity){
            this.resize(this.capacity * 2)
        }
        var off = this.data as int64 + this.size * sizeof(T)
        *(off as ptr<T>) = element
        this.size = this.size + 1
    }

    function get(index: uint64) : T {
        var off = this.data as int64 + index * sizeof(T)
        return *(off as ptr<T>)
    }

    function resize(newCapacity: uint64){
        var newData = new T[newCapacity]
        var copySize: uint64 = this.size < newCapacity ? this.size : newCapacity
        for(var i: uint64 = 0; i < copySize; i = i + 1){
            var srcOff = this.data as int64 + i * sizeof(T)
            var dstOff = newData as int64 + i * sizeof(T)
            *(dstOff as ptr<T>) = *(srcOff as ptr<T>)
        }
        free this.data
        this.data = newData
        this.capacity = newCapacity
    }
}

function main(){
    var l = new ClassList<Node>()
    l.add(Node(10))
    l.add(Node(20))
    var a = l.get(0)
    var b = l.get(1)
    if(a.getValue() == 10 && b.getValue() == 20){
        return 0
    }
    return 1
}
