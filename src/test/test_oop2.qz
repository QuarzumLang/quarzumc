class Point {
    var x: float64
    var y: float64

    function new(x: float64, y: float64) {
        this.x = x
        this.y = y
    }

    function getX() : float64 {
        return this.x
    }

    function getY() : float64 {
        return this.y
    }

    function distanceTo(other: ptr<Point>) : float64 {
        var dx = this.x - other.getX()
        var dy = this.y - other.getY()
        return dx * dx + dy * dy
    }
}

function main() {
    var p1 = new Point(1.0, 2.0)
    var p2 = new Point(4.0, 6.0)
    var dist = p1.distanceTo(p2)
    var x1 = p1.getX()
    var x2 = p2.getY()
    exit 0
}
