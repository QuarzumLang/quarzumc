// String interpolation: "${...}" desugars to concatenation with toString(...).

import "@std/string.qz"

struct P {
    var x: int64

    function P(x: int64) {
        this.x = x
    }
}

function toString(p: P): string => "P(${p.x})"

function main() {
    var a = 42
    var b = "world"

    if("hello ${b}, a=${a}!" != "hello world, a=42!") return 1
    if("${-7}" != "-7") return 1
    if("${true} ${'A'} ${9 as uint64}" != "true A 9") return 1
    if("${a + 1}" != "43") return 1
    if("${P(3)}" != "P(3)") return 1
    if("plain text" != "plain text") return 1

    return 0
}
