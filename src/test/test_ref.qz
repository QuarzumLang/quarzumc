struct Counter {
    var value: int

    function Counter() {
        this.value = 0
    }

    function increment() {
        this.value = this.value + 1
    }

    function getValue() : int {
        return this.value
    }
}

function takeRef(c: ptr<Counter>) : int {
    return c.getValue()
}

function makeCounter() : ptr<Counter> {
    return new Counter()
}

function main() {
    var c = makeCounter()
    c.increment()
    c.increment()
    var v = takeRef(c)
    free c
    exit v - 2
}
