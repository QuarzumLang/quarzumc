function main() {
    var arr = new int64[3]
    *arr = 10
    *((arr as int64 + 8) as ptr<int64>) = 20
    *((arr as int64 + 16) as ptr<int64>) = 30
    var total = *arr + *((arr as int64 + 8) as ptr<int64>) + *((arr as int64 + 16) as ptr<int64>)
    free arr
    if(total == 60) exit 0
    exit 1
}
