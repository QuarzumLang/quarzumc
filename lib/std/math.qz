/*
    @std/math.qz - 03/08/2026
    Mathematical utilities for Quarzum
*/

/*
    Returns the absolute value of an integer.

    Returns:
        - The absolute value of x: x if x >= 0,
          -x otherwise

    Arguments:
        - x: The integer to take the absolute value of

    Examples:
        abs(-3); // 3
        abs(42); // 42
*/
pure function abs(x: int64) => x < 0? -x : x

/*
    Returns the absolute value of a float.

    Returns:
        - The absolute value of x: x if x >= 0,
          -x otherwise

    Arguments:
        - x: The float to take the absolute value of

    Examples:
        abs(-3.5); // 3.5
        abs(0.25); // 0.25
*/
pure function abs(x: float64) => x < 0.0? -x : x

/*
    Returns the largest of two integers.

    Returns:
        - The maximum of a and b

    Arguments:
        - a: The first integer
        - b: The second integer

    Examples:
        max(3, 7); // 7
*/
pure function max(a: int64, b: int64) => a > b ? a : b

/*
    Returns the largest of two floats.

    Returns:
        - The maximum of a and b

    Arguments:
        - a: The first float
        - b: The second float

    Examples:
        max(3.5, 2.1); // 3.5
*/
pure function max(a: float64, b: float64) => a > b ? a : b

/*
    Returns the smallest of two integers.

    Returns:
        - The minimum of a and b

    Arguments:
        - a: The first integer
        - b: The second integer

    Examples:
        min(3, 7); // 3
*/
pure function min(a: int64, b: int64) => a < b ? a : b

/*
    Returns the smallest of two floats.

    Returns:
        - The minimum of a and b

    Arguments:
        - a: The first float
        - b: The second float

    Examples:
        min(3.5, 2.1); // 2.1
*/
pure function min(a: float64, b: float64) => a < b ? a : b

/*
    Restricts an integer to a range.

    Returns:
        - lo if value < lo
        - hi if value > hi
        - value otherwise

    Arguments:
        - value: The integer to clamp
        - lo: The lower bound of the range
        - hi: The upper bound of the range

    Examples:
        clamp(15, 0, 10); // 10
        clamp(-5, 0, 10); // 0
        clamp(7, 0, 10);  // 7
*/
pure function clamp(value: int64, lo: int64, hi: int64) => value < lo ? lo : value > hi ? hi : value

/*
    Restricts a float to a range.

    Returns:
        - lo if value < lo
        - hi if value > hi
        - value otherwise

    Arguments:
        - value: The float to clamp
        - lo: The lower bound of the range
        - hi: The upper bound of the range

    Examples:
        clamp(0.5, 0.0, 1.0); // 0.5
        clamp(-1.0, 0.0, 1.0); // 0.0
        clamp(2.0, 0.0, 1.0);  // 1.0
*/
pure function clamp(value: float64, lo: float64, hi: float64) => value < lo ? lo : value > hi ? hi : value
