/*
    @std/text/parse.qz
    Checked parsing of numbers from strings, returning `Option`.
*/
import "@std/core/option.qz"

/*
    Parses an optionally signed decimal integer. Returns None on any invalid
    character or on overflow of the accumulated magnitude.
*/
function parseInt(text: string): Option<int64> {
    if(text.length == 0) return Option.None
    var i: uint64 = 0
    var negative = false
    if(text[0] == '-') {
        negative = true
        i = 1
    } else if(text[0] == '+') {
        i = 1
    }
    if(i >= text.length) return Option.None

    var value: uint64 = 0
    while(i < text.length) {
        var c = text[i]
        if(c < '0' or c > '9') return Option.None
        value = value * 10 + ((c as uint64) - 48)
        i += 1
    }
    if(negative) return Option.Some(-(value as int64))
    return Option.Some(value as int64)
}

/*
    Parses an unsigned decimal integer. Returns None on any invalid character.
*/
function parseUInt(text: string): Option<uint64> {
    if(text.length == 0) return Option.None
    var i: uint64 = 0
    var value: uint64 = 0
    while(i < text.length) {
        var c = text[i]
        if(c < '0' or c > '9') return Option.None
        value = value * 10 + ((c as uint64) - 48)
        i += 1
    }
    return Option.Some(value)
}

/*
    Parses a decimal floating point number (`[-+]?digits[.digits]`).
    Returns None on any invalid character.
*/
function parseFloat(text: string): Option<float64> {
    if(text.length == 0) return Option.None
    var i: uint64 = 0
    var negative = false
    if(text[0] == '-') {
        negative = true
        i = 1
    } else if(text[0] == '+') {
        i = 1
    }
    if(i >= text.length) return Option.None

    var value = 0.0 as float64
    var seenDigit = false
    while(i < text.length and text[i] != '.') {
        var c = text[i]
        if(c < '0' or c > '9') return Option.None
        value = value * (10.0 as float64) + ((c as uint64) - 48) as float64
        seenDigit = true
        i += 1
    }
    if(i < text.length and text[i] == '.') {
        i += 1
        var scale = 1.0 as float64
        while(i < text.length) {
            var d = text[i]
            if(d < '0' or d > '9') return Option.None
            scale = scale * (0.1 as float64)
            value = value + (((d as uint64) - 48) as float64) * scale
            seenDigit = true
            i += 1
        }
    }
    if(not seenDigit) return Option.None
    if(negative) return Option.Some(-value)
    return Option.Some(value)
}
