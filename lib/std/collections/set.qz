/*
    @std/collections/set.qz
    Set<T>: a hash set with open addressing (linear probing).

    Elements are hashed with `hashValue` and compared with `equals`
    (`@std/core/compare.qz`).
*/
import "@std/core/option.qz"
import "@std/core/compare.qz"

struct Set<T> {
    var data: ptr<T>
    // 0 = empty, 1 = occupied.
    var occupied: ptr<uint8>
    var capacity: uint64
    var size: uint64

    function Set() {
        this.capacity = 16
        this.size = 0
        this.data = new T[this.capacity]
        this.occupied = new uint8[this.capacity]
        this.clearSlots()
    }

    function Set(initialCapacity: uint64) {
        var cap = initialCapacity < 4 ? 4 : initialCapacity
        this.capacity = cap
        this.size = 0
        this.data = new T[cap]
        this.occupied = new uint8[cap]
        this.clearSlots()
    }

    function isOcc(idx: uint64) : bool => this.occupied[idx] != 0

    function clearSlots() {
        var i: uint64 = 0
        while(i < this.capacity) {
            this.occupied[i] = 0
            i += 1
        }
    }

    function slotOf(value: T) : uint64 => hashValue(value) % this.capacity

    function add(element: T) {
        if(this.size * 3 >= this.capacity * 2) {
            this.resize(this.capacity * 2)
        }
        var idx = this.slotOf(element)
        while(this.isOcc(idx)) {
            if(equals(this.data[idx], element)) return
            idx = (idx + 1) % this.capacity
        }
        this.data[idx] = element
        this.occupied[idx] = 1
        this.size = this.size + 1
    }

    function contains(element: T) : bool {
        var idx = this.slotOf(element)
        while(this.isOcc(idx)) {
            if(equals(this.data[idx], element)) return true
            idx = (idx + 1) % this.capacity
        }
        return false
    }

    function remove(element: T) : bool {
        var idx = this.slotOf(element)
        while(this.isOcc(idx)) {
            if(equals(this.data[idx], element)) {
                this.occupied[idx] = 0
                this.size = this.size - 1
                this.rehashAfterRemove(idx)
                return true
            }
            idx = (idx + 1) % this.capacity
        }
        return false
    }

    function rehashAfterRemove(removedIdx: uint64) {
        var idx = (removedIdx + 1) % this.capacity
        while(this.isOcc(idx)) {
            var value = this.data[idx]
            this.occupied[idx] = 0
            this.size = this.size - 1
            var newIdx = this.slotOf(value)
            while(this.isOcc(newIdx)) {
                newIdx = (newIdx + 1) % this.capacity
            }
            this.data[newIdx] = value
            this.occupied[newIdx] = 1
            this.size = this.size + 1
            idx = (idx + 1) % this.capacity
        }
    }

    function forEach(f: (T) => void) {
        var i: uint64 = 0
        while(i < this.capacity) {
            if(this.isOcc(i)) {
                f(this.data[i])
            }
            i += 1
        }
    }

    function size() : uint64 => this.size

    function isEmpty() : bool => this.size == 0

    function clear() {
        this.clearSlots()
        this.size = 0
    }

    function resize(newCapacity: uint64) {
        var oldData = this.data
        var oldOccupied = this.occupied
        var oldCapacity: uint64 = this.capacity
        this.data = new T[newCapacity]
        this.occupied = new uint8[newCapacity]
        this.capacity = newCapacity
        this.size = 0
        this.clearSlots()
        var i: uint64 = 0
        while(i < oldCapacity) {
            if(oldOccupied[i] != 0) {
                this.add(oldData[i])
            }
            i += 1
        }
        free oldData
        free oldOccupied
    }

    /*
        Union with `other` into a new set.
    */
    function getUnion(other: ptr<Set<T>>) : ptr<Set<T>> {
        var result = new Set<T>(this.capacity + other.capacity)
        var i: uint64 = 0
        while(i < this.capacity) {
            if(this.isOcc(i)) result.add(this.data[i])
            i += 1
        }
        i = 0
        while(i < other.capacity) {
            if(other.isOcc(i)) result.add(other.data[i])
            i += 1
        }
        return result
    }

    /*
        Intersection with `other` into a new set.
    */
    function intersection(other: ptr<Set<T>>) : ptr<Set<T>> {
        var result = new Set<T>(this.size + 1)
        var i: uint64 = 0
        while(i < this.capacity) {
            if(this.isOcc(i) and other.contains(this.data[i])) {
                result.add(this.data[i])
            }
            i += 1
        }
        return result
    }

    /*
        Elements of this set that are not in `other`, into a new set.
    */
    function difference(other: ptr<Set<T>>) : ptr<Set<T>> {
        var result = new Set<T>(this.size + 1)
        var i: uint64 = 0
        while(i < this.capacity) {
            if(this.isOcc(i) and not other.contains(this.data[i])) {
                result.add(this.data[i])
            }
            i += 1
        }
        return result
    }

    function release() {
        free this.data
        free this.occupied
        this.data = null
        this.occupied = null
        this.capacity = 0
        this.size = 0
    }
}
