/*
    @std/collections/set.qz - 02/08/2026
    Set definition for the Quarzum Standard Library
*/
import "@std/collections/traits/collection.qz"

/*
    Defines a generic Set, a dynamic size collection of data.

    Stores elements by value, does not allow duplicated values.
*/  
class Set<T> implements Collection<T> {

    // Raw data pointer
    var data: ptr<T>
    var occupied: ptr<uint8>
    // The maximum capacity of the Set without resizing it
    var capacity: uint64
    // The count of elements inside the Set. Always lower or equal than the capacity.
    var size: uint64

    function new(){
        this.capacity = 16
        this.size = 0
        this.data = alloc T[this.capacity]
        this.occupied = alloc uint8[this.capacity]
        this.clearSlots()
    }

    function occAddr(idx: uint64) : int64 {
        return this.occupied as int64 + idx
    }

    function isOcc(idx: uint64) : bool {
        return *((this.occAddr(idx)) as ptr<uint8>) != 0
    }

    function setOcc(idx: uint64, val: uint8){
        *((this.occAddr(idx)) as ptr<uint8>) = val
    }

    function clearSlots(){
        for(var i: uint64 = 0; i < this.capacity; i = i + 1){
            this.setOcc(i, 0)
        }
    }

    function elemAddr(idx: uint64) : int64 {
        return this.data as int64 + idx * sizeof(T)
    }

    function hash(key: T) : uint64 {
        return (key as uint64) % this.capacity
    }

    function add(element: T){
        if(this.size * 3 >= this.capacity * 2){
            this.resize(this.capacity * 2)
        }
        var idx = this.hash(element)
        while(this.isOcc(idx)){
            if(*((this.elemAddr(idx)) as ptr<T>) == element){
                return
            }
            idx = (idx + 1) % this.capacity
        }
        *((this.elemAddr(idx)) as ptr<T>) = element
        this.setOcc(idx, 1)
        this.size = this.size + 1
    }

    function remove(element: T) : bool {
        var idx = this.hash(element)
        while(this.isOcc(idx)){
            if(*((this.elemAddr(idx)) as ptr<T>) == element){
                this.setOcc(idx, 0)
                this.size = this.size - 1
                this.rehashAfterRemove(idx)
                return true
            }
            idx = (idx + 1) % this.capacity
        }
        return false
    }

    function rehashAfterRemove(removedIdx: uint64){
        var idx = (removedIdx + 1) % this.capacity
        while(this.isOcc(idx)){
            var elem = *((this.elemAddr(idx)) as ptr<T>)
            this.setOcc(idx, 0)
            this.size = this.size - 1
            var newIdx = this.hash(elem)
            while(this.isOcc(newIdx)){
                newIdx = (newIdx + 1) % this.capacity
            }
            *((this.elemAddr(newIdx)) as ptr<T>) = elem
            this.setOcc(newIdx, 1)
            this.size = this.size + 1
            idx = (idx + 1) % this.capacity
        }
    }

    function contains(element: T) : bool {
        var idx = this.hash(element)
        while(this.isOcc(idx)){
            if(*((this.elemAddr(idx)) as ptr<T>) == element){
                return true
            }
            idx = (idx + 1) % this.capacity
        }
        return false
    }

    function size() : uint64 {
        return this.size
    }

    function isEmpty() : bool {
        return this.size == 0
    }

    function clear(){
        this.clearSlots()
        this.size = 0
    }

    function getUnion(other: Set<T>) : Set<T> {
        var result = new Set<T>()
        for(var i: uint64 = 0; i < this.capacity; i = i + 1){
            if(this.isOcc(i)){
                result.add(*((this.elemAddr(i)) as ptr<T>))
            }
        }
        for(var j: uint64 = 0; j < other.capacity; j = j + 1){
            if(other.isOcc(j)){
                result.add(*((other.elemAddr(j)) as ptr<T>))
            }
        }
        return result
    }

    function intersection(other: Set<T>) : Set<T> {
        var result = new Set<T>()
        for(var i: uint64 = 0; i < this.capacity; i = i + 1){
            if(this.isOcc(i)){
                var elem = *((this.elemAddr(i)) as ptr<T>)
                if(other.contains(elem)){
                    result.add(elem)
                }
            }
        }
        return result
    }

    function difference(other: Set<T>) : Set<T> {
        var result = new Set<T>()
        for(var i: uint64 = 0; i < this.capacity; i = i + 1){
            if(this.isOcc(i)){
                var elem = *((this.elemAddr(i)) as ptr<T>)
                if(other.contains(elem) == false){
                    result.add(elem)
                }
            }
        }
        return result
    }

    function resize(newCapacity: uint64){
        var oldData = this.data
        var oldOccupied = this.occupied
        var oldCapacity: uint64 = this.capacity
        this.data = alloc T[newCapacity]
        this.occupied = alloc uint8[newCapacity]
        this.capacity = newCapacity
        this.size = 0
        this.clearSlots()
        for(var i: uint64 = 0; i < oldCapacity; i = i + 1){
            if(*((oldOccupied as int64 + i) as ptr<uint8>) != 0){
                this.add(*((oldData as int64 + i * sizeof(T)) as ptr<T>))
            }
        }
        free oldData
        free oldOccupied
    }
}
