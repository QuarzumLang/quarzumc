/*
    @std/collections/stack.qz
    Stack<T>: a LIFO collection backed by `List<T>`.
*/
import "@std/collections/list.qz"
import "@std/core/option.qz"

struct Stack<T> {
    var items: ptr<List<T>>

    function Stack() {
        this.items = new List<T>()
    }

    function Stack(capacity: uint64) {
        this.items = new List<T>(capacity)
    }

    function push(element: T) {
        this.items.add(element)
    }

    function pop() : Option<T> => this.items.pop()

    function peek() : Option<T> => this.items.last()

    function size() : uint64 => this.items.size()

    function isEmpty() : bool => this.items.isEmpty()

    function clear() {
        this.items.clear()
    }

    function release() {
        this.items.release()
        free this.items
        this.items = null
    }
}
