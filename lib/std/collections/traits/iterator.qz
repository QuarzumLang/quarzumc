/*
    @std/collections/traits/iterator.qz - 07/08/2026
    Iterator trait for the Quarzum Standard Library
*/
import "@std/types/optional.qz"
/*
    Defines a generic Iterator. An Iterator allows to fetch
    the next element in a sequence.

*/
trait Iterator<T> {
    /*
        Gets the next element in the sequence.

        Returns:
            - The next value in the sequence, if it has not ended
            - None if the sequence has ended
    */
    function next(): Optional<T>
}