/*
    @std/collections/sort.qz
    In-place sorting of `List<T>` with a comparator `(T, T) => int64`.

    The comparator returns a negative value, zero, or a positive value when the
    first argument is less than, equal to, or greater than the second (see
    `compare` in `@std/core/compare.qz`).

        sort(xs, cmp)
        var ys = sorted(xs, cmp)
*/
import "@std/collections/list.qz"

// In-place quicksort of the range [lo, hi] (inclusive indices).
function sortRange<T>(list: ptr<List<T>>, lo: int64, hi: int64, cmp: (T, T) => int64) {
    if(lo >= hi) return
    var pivot = list.getUnchecked(hi as uint64)
    var i = lo - 1
    var j = lo
    while(j < hi) {
        if(cmp(list.getUnchecked(j as uint64), pivot) <= 0) {
            i = i + 1
            var tmp = list.getUnchecked(i as uint64)
            list.set(i as uint64, list.getUnchecked(j as uint64))
            list.set(j as uint64, tmp)
        }
        j = j + 1
    }
    i = i + 1
    var last = list.getUnchecked(i as uint64)
    list.set(i as uint64, pivot)
    list.set(hi as uint64, last)
    sortRange(list, lo, i - 1, cmp)
    sortRange(list, i + 1, hi, cmp)
}

/*
    Sorts `list` in place.
*/
function sort<T>(list: ptr<List<T>>, cmp: (T, T) => int64) {
    if(list.size() <= 1) return
    sortRange(list, 0, (list.size() - 1) as int64, cmp)
}

/*
    Returns a new, sorted copy of `list`. The caller owns the result.
*/
function sorted<T>(list: ptr<List<T>>, cmp: (T, T) => int64) : ptr<List<T>> {
    var copy = new List<T>(list.size())
    var i: uint64 = 0
    while(i < list.size()) {
        copy.add(list.getUnchecked(i))
        i += 1
    }
    sort(copy, cmp)
    return copy
}
