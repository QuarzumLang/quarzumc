/*
    @std/collections/list.qz
    List<T>: a contiguous, growable array (a dynamic array / vector).

    Elements are stored inline, so a List<T> is cache-friendly and indexing is
    O(1). Growth doubles the capacity. Use it as the default sequence type.

        var xs = new List<int64>()
        defer xs.release()
        xs.add(10)
        xs.add(20)
        match(xs.get(1)) {
            case Some(v: int64) => use(v),
            case None => useDefault()
        }

    `contains`, `indexOf` and `remove` compare elements with the `==` operator.
    For primitives and `string` this is value equality; structs do not have
    structural equality in the language yet.
*/
import "@std/core/option.qz"
import "@std/core/compare.qz"

struct List<T> {
    // Raw data pointer.
    var data: ptr<T>
    // Allocated slots (in elements).
    var capacity: uint64
    // Number of elements currently stored.
    var size: uint64

    /*
        Creates an empty List with an initial capacity of 16.
    */
    function List() {
        this.capacity = 16
        this.size = 0
        this.data = new T[this.capacity]
    }

    /*
        Creates an empty List with an initial capacity of at least 1.
    */
    function List(initialCapacity: uint64) {
        var cap = initialCapacity < 1 ? 1 : initialCapacity
        this.capacity = cap
        this.size = 0
        this.data = new T[cap]
    }

    /*
        Number of elements in the List.
    */
    function size() : uint64 => this.size

    /*
        true when the List has no elements.
    */
    function isEmpty() : bool => this.size == 0

    /*
        Appends an element, growing the capacity when needed.
    */
    function add(element: T) {
        if(this.size >= this.capacity) {
            this.resize(this.capacity * 2)
        }
        *((this.data as int64 + this.size * sizeof(T)) as ptr<T>) = element
        this.size = this.size + 1
    }

    /*
        Alias for `add`.
    */
    function push(element: T) {
        this.add(element)
    }

    /*
        Removes and returns the last element, if any.
    */
    function pop() : Option<T> {
        if(this.size == 0) return Option.None
        this.size = this.size - 1
        return Option.Some(this.data[this.size])
    }

    /*
        Returns the element at `index`, or None if out of bounds.
    */
    function get(index: uint64) : Option<T> {
        if(index >= this.size) return Option.None
        return Option.Some(this.data[index])
    }

    /*
        Returns the element at `index` without bounds checking. The caller must
        guarantee `index < size`.
    */
    function getUnchecked(index: uint64) : T => this.data[index]

    /*
        Overwrites the element at `index`. Returns false if out of bounds.
    */
    function set(index: uint64, value: T) : bool {
        if(index >= this.size) return false
        *((this.data as int64 + index * sizeof(T)) as ptr<T>) = value
        return true
    }

    /*
        Inserts `element` at `index`, shifting the following elements right.
        Returns false if `index > size`.
    */
    function insert(index: uint64, element: T) : bool {
        if(index > this.size) return false
        if(this.size >= this.capacity) {
            this.resize(this.capacity * 2)
        }
        var i = this.size
        while(i > index) {
            *((this.data as int64 + i * sizeof(T)) as ptr<T>) = this.data[i - 1]
            i = i - 1
        }
        *((this.data as int64 + index * sizeof(T)) as ptr<T>) = element
        this.size = this.size + 1
        return true
    }

    /*
        Removes the element at `index` and returns it, or None if out of
        bounds.
    */
    function removeAt(index: uint64) : Option<T> {
        if(index >= this.size) return Option.None
        var old = this.data[index]
        var i = index
        while(i < this.size - 1) {
            *((this.data as int64 + i * sizeof(T)) as ptr<T>) = this.data[i + 1]
            i = i + 1
        }
        this.size = this.size - 1
        return Option.Some(old)
    }

    /*
        First index of `element` (by `==`), or None if absent.
    */
    function indexOf(element: T) : Option<uint64> {
        var i: uint64 = 0
        while(i < this.size) {
            if(this.data[i] == element) return Option.Some(i)
            i = i + 1
        }
        return Option.None
    }

    /*
        true when `element` is present (by `==`).
    */
    function contains(element: T) : bool {
        var i: uint64 = 0
        while(i < this.size) {
            if(this.data[i] == element) return true
            i = i + 1
        }
        return false
    }

    /*
        Removes the first occurrence of `element` (by `==`). Returns true if an
        element was removed.
    */
    function remove(element: T) : bool {
        var i: uint64 = 0
        while(i < this.size) {
            if(this.data[i] == element) {
                this.removeAt(i)
                return true
            }
            i = i + 1
        }
        return false
    }

    /*
        Removes all elements. The capacity is kept.
    */
    function clear() {
        this.size = 0
    }

    /*
        Calls `f(element)` for every element, in order.
    */
    function forEach(f: (T) => void) {
        var i: uint64 = 0
        while(i < this.size) {
            f(this.data[i])
            i += 1
        }
    }

    /*
        First element, or None if the List is empty.
    */
    function first() : Option<T> {
        if(this.size == 0) return Option.None
        return Option.Some(this.data[0])
    }

    /*
        Last element, or None if the List is empty.
    */
    function last() : Option<T> {
        if(this.size == 0) return Option.None
        return Option.Some(this.data[this.size - 1])
    }

    /*
        A zero-copy slice view over the current elements.
    */
    function asSlice() : T[] {
        var slice: T[]
        slice.ptr = this.data
        slice.length = this.size
        return slice
    }

    /*
        A deep copy of the current elements into a fresh slice. The caller owns
        the returned buffer.
    */
    function cloneData() : T[] {
        var slice: T[]
        slice.length = this.size
        slice.ptr = new T[this.size]
        var i: uint64 = 0
        while(i < this.size) {
            *((slice.ptr as int64 + i * sizeof(T)) as ptr<T>) = this.data[i]
            i = i + 1
        }
        return slice
    }

    /*
        Grows the buffer to `newCapacity` elements, copying the live elements.
    */
    function resize(newCapacity: uint64) {
        var newData = new T[newCapacity]
        var copySize = this.size < newCapacity ? this.size : newCapacity
        var i: uint64 = 0
        while(i < copySize) {
            *((newData as int64 + i * sizeof(T)) as ptr<T>) = this.data[i]
            i = i + 1
        }
        free this.data
        this.data = newData
        this.capacity = newCapacity
    }

    /*
        Releases the backing buffer. The List must not be used afterwards.
    */
    function release() {
        free this.data
        this.data = null
        this.capacity = 0
        this.size = 0
    }
}

/*
    Value-equality variants of the search operations. They use `equals` and are
    only instantiated when called, so a `List<Struct>` compiles without
    requiring an `equals` overload unless you actually compare elements. Define
    an `equals(a: T, b: T)` overload (or implement `Eq<T>`) for your struct to
    use them.
*/
function listContains<T>(list: ptr<List<T>>, element: T) : bool {
    var i: uint64 = 0
    while(i < list.size) {
        if(equals(list.data[i], element)) return true
        i = i + 1
    }
    return false
}

function listIndexOf<T>(list: ptr<List<T>>, element: T) : Option<uint64> {
    var i: uint64 = 0
    while(i < list.size) {
        if(equals(list.data[i], element)) return Option.Some(i)
        i = i + 1
    }
    return Option.None
}

function listRemove<T>(list: ptr<List<T>>, element: T) : bool {
    var i: uint64 = 0
    while(i < list.size) {
        if(equals(list.data[i], element)) {
            list.removeAt(i)
            return true
        }
        i = i + 1
    }
    return false
}
