/*
    @std/collections/map.qz
    Map<K, V>: a hash map with open addressing (linear probing).

    Keys are hashed with `hashValue` and compared with `equals`
    (`@std/core/compare.qz`), so primitive types, `string` and any type with
    those overloads work as keys.

        var m = new Map<string, int64>()
        defer m.release()
        m.put("one", 1)
        match(m.get("one")) {
            case Some(v: int64) => use(v),
            case None => useDefault()
        }
*/
import "@std/core/option.qz"
import "@std/core/compare.qz"

struct Map<K, V> {
    var keys: ptr<K>
    var values: ptr<V>
    // 0 = empty, 1 = occupied.
    var occupied: ptr<uint8>
    var capacity: uint64
    var size: uint64

    function Map() {
        this.capacity = 16
        this.size = 0
        this.keys = new K[this.capacity]
        this.values = new V[this.capacity]
        this.occupied = new uint8[this.capacity]
        this.clearSlots()
    }

    function Map(initialCapacity: uint64) {
        var cap = initialCapacity < 4 ? 4 : initialCapacity
        this.capacity = cap
        this.size = 0
        this.keys = new K[cap]
        this.values = new V[cap]
        this.occupied = new uint8[cap]
        this.clearSlots()
    }

    function isOcc(idx: uint64) : bool => this.occupied[idx] != 0

    function setOcc(idx: uint64, val: uint8) {
        this.occupied[idx] = val
    }

    function clearSlots() {
        var i: uint64 = 0
        while(i < this.capacity) {
            this.occupied[i] = 0
            i += 1
        }
    }

    function slotOf(key: K) : uint64 => hashValue(key) % this.capacity

    function put(key: K, value: V) {
        if(this.size * 3 >= this.capacity * 2) {
            this.resize(this.capacity * 2)
        }
        var idx = this.slotOf(key)
        while(this.isOcc(idx)) {
            if(equals(this.keys[idx], key)) {
                this.values[idx] = value
                return
            }
            idx = (idx + 1) % this.capacity
        }
        this.keys[idx] = key
        this.values[idx] = value
        this.setOcc(idx, 1)
        this.size = this.size + 1
    }

    function get(key: K) : Option<V> {
        var idx = this.slotOf(key)
        while(this.isOcc(idx)) {
            if(equals(this.keys[idx], key)) {
                return Option.Some(this.values[idx])
            }
            idx = (idx + 1) % this.capacity
        }
        return Option.None
    }

    function has(key: K) : bool {
        var idx = this.slotOf(key)
        while(this.isOcc(idx)) {
            if(equals(this.keys[idx], key)) return true
            idx = (idx + 1) % this.capacity
        }
        return false
    }

    function remove(key: K) : bool {
        var idx = this.slotOf(key)
        while(this.isOcc(idx)) {
            if(equals(this.keys[idx], key)) {
                this.setOcc(idx, 0)
                this.size = this.size - 1
                this.rehashAfterRemove(idx)
                return true
            }
            idx = (idx + 1) % this.capacity
        }
        return false
    }

    // After clearing a slot, move the following cluster back so probing still
    // finds every key.
    function rehashAfterRemove(removedIdx: uint64) {
        var idx = (removedIdx + 1) % this.capacity
        while(this.isOcc(idx)) {
            var k = this.keys[idx]
            var v = this.values[idx]
            this.setOcc(idx, 0)
            this.size = this.size - 1
            var newIdx = this.slotOf(k)
            while(this.isOcc(newIdx)) {
                newIdx = (newIdx + 1) % this.capacity
            }
            this.keys[newIdx] = k
            this.values[newIdx] = v
            this.setOcc(newIdx, 1)
            this.size = this.size + 1
            idx = (idx + 1) % this.capacity
        }
    }

    /*
        Calls `f(key, value)` for every entry.
    */
    function forEach(f: (K, V) => void) {
        var i: uint64 = 0
        while(i < this.capacity) {
            if(this.isOcc(i)) {
                f(this.keys[i], this.values[i])
            }
            i += 1
        }
    }

    /*
        A freshly allocated array of the keys. The caller owns the buffer.
    */
    function keysArray() : ptr<K> {
        var result = new K[this.size]
        var pos: uint64 = 0
        var i: uint64 = 0
        while(i < this.capacity) {
            if(this.isOcc(i)) {
                *((result as int64 + pos * sizeof(K)) as ptr<K>) = this.keys[i]
                pos += 1
            }
            i += 1
        }
        return result
    }

    /*
        A freshly allocated array of the values. The caller owns the buffer.
    */
    function valuesArray() : ptr<V> {
        var result = new V[this.size]
        var pos: uint64 = 0
        var i: uint64 = 0
        while(i < this.capacity) {
            if(this.isOcc(i)) {
                *((result as int64 + pos * sizeof(V)) as ptr<V>) = this.values[i]
                pos += 1
            }
            i += 1
        }
        return result
    }

    function size() : uint64 => this.size

    function isEmpty() : bool => this.size == 0

    function clear() {
        this.clearSlots()
        this.size = 0
    }

    function resize(newCapacity: uint64) {
        var oldKeys = this.keys
        var oldValues = this.values
        var oldOccupied = this.occupied
        var oldCapacity: uint64 = this.capacity
        this.keys = new K[newCapacity]
        this.values = new V[newCapacity]
        this.occupied = new uint8[newCapacity]
        this.capacity = newCapacity
        this.size = 0
        this.clearSlots()
        var i: uint64 = 0
        while(i < oldCapacity) {
            if(oldOccupied[i] != 0) {
                this.put(oldKeys[i], oldValues[i])
            }
            i += 1
        }
        free oldKeys
        free oldValues
        free oldOccupied
    }

    function release() {
        free this.keys
        free this.values
        free this.occupied
        this.keys = null
        this.values = null
        this.occupied = null
        this.capacity = 0
        this.size = 0
    }
}
