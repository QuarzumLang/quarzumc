/*
    @std/test/assertions.qz - 07/08/2026
    Basic assertions for the Quarzum Standard Library
*/
import "@std/io.qz"
/*
    Asserts a boolean value.

    If the condition is false, the program exits and
    sends a message through stderr.
*/
function assert(condition: bool, message: string){
    if(not condition){
        eprintln("Assertion failed: " + message)
        exit 134
    }
}

/*
    Asserts a boolean value.

    If the condition is false, the program exits and
    sends a generic message through stderr;
*/
function assert(condition: bool){
    if(not condition){
        eprintln("Assertion failed (No message available)")
        exit 134
    }
}

/*
    Asserts that two values are equal.

    If the condition is false, the program exits and
    sends a message through stderr.
*/
function assertEquals<T>(left: T, right: T, message: string) => assert(left == right, message)


/*
    Asserts that two values are not equal.

    If the condition is false, the program exits and
    sends a message through stderr.
*/
function assertDoesNotEqual<T>(left: T, right: T, message: string) => assert(left != right, message)


/*
    Asserts that a value is true.

    If the condition is false, the program exits and
    sends a message through stderr.
*/
function assertTrue(value: bool, message: string) => assert(value, message)

/*
    Asserts that a value is false.

    If the condition is false, the program exits and
    sends a message through stderr.
*/
function assertFalse(value: bool, message: string) => assert(not value, message)
