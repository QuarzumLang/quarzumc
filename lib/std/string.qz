/*
    string.qz - 02/08/2026
    String conversions and operations for the Quarzum
    Standard Library
*/

/*
    Converts a char into a string.

    Arguments:
        - c: The character to be converted

    Returns: 
        - A string with length = 1

    Warning:
        Allocates 1 byte of memory, does not use
        the original character pointer.
*/
function toString(c: char): string {
    var str: string
    str.length = 1
    str.ptr = alloc char[1]
    *((str.ptr as int64) as ptr<char>) = c
    return str
}

/*
    Converts a bool into a string.

    Arguments:
        - boolean: The boolean value to be converted

    Returns: 
        - "true" if boolean == true, "false" otherwise
*/
pure function toString(boolean: bool): string {
    return boolean ? "true" : "false"
}

/*
    Converts an unsigned integer into a string.

    Arguments:
        - value: The value to be converted

    Returns: 
        - A string with the value in decimal

*/
function toString(value: uint64): string {
    var tmp = value
    var length: uint64 = 1
    while(tmp >= 10){
        tmp /= 10
        length += 1
    }
    var str: string
    str.length = length
    str.ptr = alloc char[length]
    tmp = value
    var pos = length
    while(pos > 0){
        pos -= 1
        var off = str.ptr as int64 + pos
        *((off as ptr<char>)) = ((tmp % 10) + 48) as char
        tmp /= 10
    }
    return str
}

/*
    Converts an unsigned integer into a string with a
    fixed length, padding with zeros on the left.

    Arguments:
        - value: The value to be converted
        - length: The minimum length of the resulting string

    Returns: 
        - A string with the value in decimal. If the value
          has fewer digits than 'length', zeros are added on
          the left until the string reaches 'length' characters.

    Example:
        toStringWithFixedLength(12, 5) == "00012"
*/
function toStringWithFixedLength(value: uint64, length: uint64): string {
    var tmp = value
    var digits: uint64 = 1
    while(tmp >= 10){
        tmp /= 10
        digits += 1
    }
    if(digits > length) length = digits
    var str: string
    str.length = length
    str.ptr = alloc char[length]
    tmp = value
    var pos = length
    while(pos > 0){
        pos -= 1
        var off = str.ptr as int64 + pos
        *((off as ptr<char>)) = ((tmp % 10) + 48) as char
        tmp /= 10
    }
    return str
}

/*
    Checks if the first string starts with the second string.

    Arguments:
        - str1: The first string
        - str2: The string to be compared as a prefix

    Returns:
        - false if str2 is larger than str1
        - true if str1 starts with str2, false otherwise
*/
function startsWith(str1: string, str2: string): bool {
    if(str2.length > str1.length) return false
    for(var i: uint64 = 0; i < str2.length; i += 1){
        if(str1[i] != str2[i]) return false
    }
    return true
}

/*
    Checks if the first string ends with the second string.

    Arguments:
        - str1: The first string
        - str2: The string to be compared as a suffix

    Returns:
        - false if str2 is larger than str1
        - true if str1 ends with str2, false otherwise
*/
function endsWith(str1: string, str2: string): bool {
    if(str2.length > str1.length) return false 
    const offset = str1.length - str2.length
    var i: int64 = 0
    while(i < str2.length){
        if(str1[offset + i] != str2[i]) return false
        i += 1
    }
    return true
}

/*
    Obtains a substring from an existing string.

    Arguments:
        - str: The original string
        - start: The start index of the substring
        - end: The end index of the substring

    Returns:
        - A partial view of the original string

    Warning:
        - Does not create a new string
*/
function substring(str: string, start: uint64, end: uint64): string {
    var result: string
    result.pointer = (str.ptr as int64 + start) as ptr<char>
    result.length = end - start
    return result
}

/*
    Copies a portion of a string into a new string.

    Arguments:
        - str: The source string
        - start: The start index of the portion
        - length: The number of characters to copy

    Returns:
        - A new string with a deep copy of the portion

    Warning:
        - Allocates 'length' bytes of memory; the caller owns
          the returned buffer.
*/
function slice(str: string, start: uint64, length: uint64): string {
    var result: string
    result.length = length
    result.ptr = alloc char[length]
    var i: uint64 = 0
    while(i < length){
        *((result.ptr as int64 + i) as ptr<char>) = str[start + i]
        i += 1
    }
    return result
}


function decimalToUInt64(text: string): uint64 {
    var value: uint64 = 0
    var i: uint64 = 0
    while(i < text.length){
        value = value * 10 + ((text[i] as uint64) - 48)
        i += 1
    }
    return value
}

function hexToUInt64(text: string): uint64 {
    var value: uint64 = 0
    var i: uint64 = 0
    if(text.length >= 2 and text[0] == '0' and (text[1] == 'x' or text[1] == 'X')) i = 2
    while(i < text.length){
        var digit: uint64 = 0
        if(text[i] >= '0' and text[i] <= '9') digit = (text[i] as uint64) - 48
        else if(text[i] >= 'a' and text[i] <= 'f') digit = (text[i] as uint64) - 87
        else digit = (text[i] as uint64) - 55
        value = value * 16 + digit
        i += 1
    }
    return value
}

function stringToFloat64(text: string): float64 {
    var value = 0.0 as float64
    var i: uint64 = 0
    while(i < text.length and text[i] != '.'){
        var digit = (text[i] as uint64) - 48
        value = value * (10.0 as float64) + (digit as float64)
        i += 1
    }
    if(i < text.length and text[i] == '.'){
        i += 1
        var scale = 1.0 as float64
        while(i < text.length){
            var fdigit = (text[i] as uint64) - 48
            scale = scale * (0.1 as float64)
            value = value + (fdigit as float64) * scale
            i += 1
        }
    }
    return value
}
