/*
    @std/io.qz
    Standard input and output.

    `print`/`println` write directly to the standard descriptors. For
    high-throughput output, wrap a descriptor with `BufWriter`
    (`@std/io/bufwriter.qz`) and flush it explicitly.
*/
import "@std/io/fd.qz"
import "@std/io/bufreader.qz"

const STDIN_FD: int64 = 0
const STDOUT_FD: int64 = 1
const STDERR_FD: int64 = 2

/*
    Writes `message` to standard output.
*/
function print(message: string) {
    fdWrite(STDOUT_FD, message)
}

/*
    Writes `message` to standard output followed by a newline.
*/
function println(message: string) {
    fdWrite(STDOUT_FD, message)
    fdWrite(STDOUT_FD, "\n")
}

/*
    Writes `message` to standard error.
*/
function eprint(message: string) {
    fdWrite(STDERR_FD, message)
}

/*
    Writes `message` to standard error followed by a newline.
*/
function eprintln(message: string) {
    fdWrite(STDERR_FD, message)
    fdWrite(STDERR_FD, "\n")
}

/*
    Reads all of standard input into a string. The caller owns the buffer.
*/
function input() : string {
    var reader = new BufReader(STDIN_FD, 4096)
    defer reader.release()
    return reader.readAll()
}
