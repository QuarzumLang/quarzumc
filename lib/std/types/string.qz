/*
    @std/types/string.qz - 08/08/2026
    String class for the Quarzum Standard Library.

    Wraps the primitive `string` (a char[] slice) as an
    immutable, zero-copy view. Constructing a String is O(1):
    it stores the slice pointer and length without copying.
    Unwrap with toString() to get the primitive back.
*/
import "@std/string.qz"
import "@std/char.qz"
import "@std/types/optional.qz"

/*
    Defines an immutable view over a primitive string.

    Provides the complex string operations (substring,
    startsWith, contains, ...) as methods. The primitive
    `string` keeps the trivial operations at language level
    (concatenation with '+', value comparison with '==' and
    '!=', indexing and slicing).
*/
class String {
    // The underlying primitive slice; never copied.
    private var data: string

    /*
        Wraps a primitive string without copying.

        Arguments:
            - s: The primitive string to view
    */
    function new(s: string){
        this.data = s
    }

    /*
        Builds an empty String.
    */
    function new(){
        this.data = ""
    }

    /*
        Unwraps the underlying primitive string.

        Returns:
            - The primitive char[] slice backing this String
    */
    function toString(): string => this.data

    /*
        Gets the length of the String.

        Returns:
            - The number of characters
    */
    function length(): uint64 => this.data.length

    /*
        Checks if the String is empty.

        Returns:
            - true if length == 0, false otherwise
    */
    function isEmpty(): bool => this.data.length == 0

    /*
        Gets the character at an index.

        Arguments:
            - i: The index of the character

        Returns:
            - Optional.Some(char) if the index is in bounds
            - Optional.None otherwise
    */
    function charAt(i: uint64): Optional<char> {
        if(i >= this.data.length) return Optional.None
        return Optional.Some(this.data[i])
    }

    /*
        Checks if two strings are equal by value.

        Arguments:
            - other: The primitive string to compare with

        Returns:
            - true if both strings have the same content
    */
    function equals(other: string): bool => this.data == other

    /*
        Checks if the String starts with a prefix.

        Arguments:
            - prefix: The prefix to check

        Returns:
            - true if the String begins with 'prefix'
    */
    function startsWith(prefix: string): bool => startsWith(this.data, prefix)

    /*
        Checks if the String ends with a suffix.

        Arguments:
            - suffix: The suffix to check

        Returns:
            - true if the String ends with 'suffix'
    */
    function endsWith(suffix: string): bool => endsWith(this.data, suffix)

    /*
        Checks if the String contains a substring.

        Arguments:
            - needle: The substring to look for

        Returns:
            - true if 'needle' appears inside the String
    */
    function contains(needle: string): bool {
        return match(this.indexOf(needle)){
            case Some(i: uint64) => true,
            case None => false
        }
    }

    /*
        Finds the first occurrence of a substring.

        Arguments:
            - needle: The substring to look for

        Returns:
            - Optional.Some(uint64) with the index of the first
              occurrence, or 0 for an empty needle
            - Optional.None if 'needle' is not present
    */
    function indexOf(needle: string): Optional<uint64> {
        if(needle.length == 0) return Optional.Some(0)
        if(needle.length > this.data.length) return Optional.None
        var i: uint64 = 0
        while(i + needle.length <= this.data.length){
            var j: uint64 = 0
            var found = true
            while(j < needle.length){
                if(this.data[i + j] != needle[j]){
                    found = false
                    break
                }
                j += 1
            }
            if(found) return Optional.Some(i)
            i += 1
        }
        return Optional.None
    }

    /*
        Obtains a partial view of the String.

        Arguments:
            - start: The start index of the substring
            - end: The end index of the substring

        Returns:
            - A new String that is a view of the same data

        Warning:
            - Does not copy the characters
    */
    function substring(start: uint64, end: uint64): String => new String(substring(this.data, start, end))

    /*
        Appends another string to this one.

        Arguments:
            - other: The string to append

        Returns:
            - A new String with the concatenation result
    */
    function concat(other: string): String => new String(this.data + other)

    /*
        Removes leading and trailing whitespace.

        Returns:
            - A new String view without surrounding whitespace

        Warning:
            - Does not copy the characters
    */
    function trim(): String {
        var start: uint64 = 0
        var end: uint64 = this.data.length
        while(start < end and isWhitespace(this.data[start])) start += 1
        while(end > start and isWhitespace(this.data[end - 1])) end -= 1
        return new String(substring(this.data, start, end))
    }

    /*
        Converts every lowercase letter to uppercase.

        Returns:
            - A new String with uppercase letters

        Warning:
            - Allocates a new buffer; the caller owns it.
    */
    function toUpperCase(): String {
        var result: string
        result.length = this.data.length
        result.ptr = alloc char[this.data.length]
        var i: uint64 = 0
        while(i < this.data.length){
            var c = this.data[i]
            if(c >= 'a' and c <= 'z') c = ((c as uint64) - 32) as char
            *((result.ptr as int64 + i) as ptr<char>) = c
            i += 1
        }
        return new String(result)
    }

    /*
        Converts every uppercase letter to lowercase.

        Returns:
            - A new String with lowercase letters

        Warning:
            - Allocates a new buffer; the caller owns it.
    */
    function toLowerCase(): String {
        var result: string
        result.length = this.data.length
        result.ptr = alloc char[this.data.length]
        var i: uint64 = 0
        while(i < this.data.length){
            var c = this.data[i]
            if(c >= 'A' and c <= 'Z') c = ((c as uint64) + 32) as char
            *((result.ptr as int64 + i) as ptr<char>) = c
            i += 1
        }
        return new String(result)
    }
}
