/*
    @std/types/result.qz - 02/08/2026
    Result type for the Quarzum Standard Library
*/

/*
    Defines a generic Result with two states. The
    Ok state stores the result of a successful operation,
    while the Err state stores the error stored from an
    unsuccessful operation. 

    Should be used in operations where a runtime error
    could emerge, like file operations.

    Examples:
        var result: Result<int, Error>;

        result = Result.Ok(3);

        switch(result){
            case Ok(i: int):
                exit i;
                break;
            case Err(e: Error):
                exit 255;
                break;
        }
*/
enum Result<T,E> {
    Ok(T),
    Err(E)
}

function isOk<T, E>(result: Result<T, E>): bool => match(result){
    case Ok(value: T) => true
    case Err(e: E) => false
}

function isErr<T, E>(result: Result<T, E>): bool => match(result){
    case Ok(value: T) => false
    case Err(e: E) => true
}

function unwrap<T, E>(result: Result<T, E>): T {
    switch(result){
        case Err(e: E):
            // panic
            exit 1
        case Ok(value: T){
            return value
        }
    }
}

function unwrapErr<T, E>(result: Result<T, E>): T {
    switch(result){
        case Err(e: E):
            return e
        case Ok(value: T){
            // panic
            exit 1
        }
    }
}